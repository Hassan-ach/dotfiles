# ==============================
# ZSH Plugins (Manual Management)
# ==============================

export ZSH_PLUGINS_DIR="$HOME/dotfiles/zsh/plugins"

# Auto-install a plugin if missing or incomplete, then source it
_zplugin_load() {
  local repo=$1
  local name=${repo:t}
  local plugin_path="${ZSH_PLUGINS_DIR}/${name}"

  if [[ ! -d "$plugin_path" || ( ! -f "${plugin_path}/${name}.plugin.zsh" && ! -f "${plugin_path}/${name}.zsh" ) ]]; then
    echo "Installing ${name}..."
    rm -rf "$plugin_path"
    mkdir -p "$ZSH_PLUGINS_DIR"
    git clone --depth=1 "https://github.com/${repo}.git" "$plugin_path" \
      || { echo "ERROR: failed to install ${name}" >&2; return 1; }
  fi

  zsource "${plugin_path}/${name}.plugin.zsh"
}

# Update all plugins
zplugin-update() {
  local dir
  for dir in "${ZSH_PLUGINS_DIR}"/*/; do
    echo "Updating ${dir:t}..."
    git -C "$dir" pull --ff-only
  done
}

# ==============================
# Plugin Configuration
# ==============================

# zvm_config is called by zsh-vi-mode during sourcing, so it must be
# defined *before* the plugin is loaded.
zvm_config() {
  ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BEAM
  ZVM_NORMAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
  ZVM_VISUAL_MODE_CURSOR=$ZVM_CURSOR_BLINKING_BLOCK
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
  ZVM_KEYTIMEOUT=0.4
}

# History substring search
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='%F{cyan}%U'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='%F{red}%U'
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_TIMEOUT=5
HISTORY_SUBSTRING_SEARCH_PREFIXED=1
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
HISTORY_SUBSTRING_SEARCH_FUZZY=1

# Autosuggestions
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#9ccfd8'
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_USE_ASYNC=1

# ==============================
# Load Plugins (highlighting last)
# ==============================
_zplugin_load zsh-users/zsh-autosuggestions
_zplugin_load Aloxaf/fzf-tab
_zplugin_load zsh-users/zsh-history-substring-search
_zplugin_load jeffreytse/zsh-vi-mode
_zplugin_load zsh-users/zsh-syntax-highlighting

# fzf-tab: preview dirs with eza, files with bat
zstyle ':fzf-tab:complete:*:*' fzf-preview \
  '[[ -d $realpath ]] && eza -la --color=always --icons=auto $realpath || bat --color=always --style=numbers --line-range=:500 $realpath 2>/dev/null'
zstyle ':fzf-tab:*' switch-group '<' '>'
