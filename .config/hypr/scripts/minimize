#!/usr/bin/env bash

TMP_FILE="$XDG_RUNTIME_DIR/hyprland-show-desktop"

CURRENT_WORKSPACE=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.name')
STATE="$TMP_FILE-$CURRENT_WORKSPACE"

CMDS=""

move() { # $1 = workspace, $2 = address
  printf 'dispatch hl.dsp.window.move({workspace="%s", follow=false, window="address:%s"});' "$1" "$2"
}

if [ -s "$STATE" ]; then
  while IFS= read -r address; do
    [[ -n "$address" ]] && CMDS+="$(move "name:$CURRENT_WORKSPACE" "$address")"
  done <"$STATE"

  [[ -n "$CMDS" ]] && hyprctl --batch "$CMDS"
  rm -f "$STATE"
else
  mapfile -t ADDRESS_ARRAY < <(
    hyprctl clients -j | jq -r --arg CW "$CURRENT_WORKSPACE" \
      '.[] | select(.workspace.name == $CW) | .address'
  )

  [[ ${#ADDRESS_ARRAY[@]} -eq 0 ]] && exit 0

  : >"$STATE"
  for address in "${ADDRESS_ARRAY[@]}"; do
    [[ -z "$address" ]] && continue
    echo "$address" >>"$STATE"
    CMDS+="$(move "special:desktop" "$address")"
  done

  hyprctl --batch "$CMDS"
fi
