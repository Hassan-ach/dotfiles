#!/usr/bin/env bash

set -euo pipefail

TMP_FILE="${XDG_RUNTIME_DIR:-/tmp}/hyprland-show-desktop"

CURRENT_WORKSPACE=$(
    hyprctl monitors -j |
    jq -r '.[] | select(.focused == true) | .activeWorkspace.name'
)

STATE_FILE="${TMP_FILE}-${CURRENT_WORKSPACE}"

if [[ -f "$STATE_FILE" && -s "$STATE_FILE" ]]; then
    while IFS= read -r address; do
        [[ -z "$address" ]] && continue
        hyprctl eval "hl.dispatch(hl.dsp.movetoworkspacesilent({ workspace = \"name:${CURRENT_WORKSPACE}\", address = \"${address}\" }))"
    done < "$STATE_FILE"

    rm -f "$STATE_FILE"
else
    hyprctl clients -j |
    jq -r --arg ws "$CURRENT_WORKSPACE" '
        .[]
        | select(.workspace.name == $ws)
        | .address
    ' | tee "$STATE_FILE" | while IFS= read -r address; do
        [[ -z "$address" ]] && continue
        hyprctl eval "hl.dispatch(hl.dsp.movetoworkspacesilent({ workspace = \"special:desktop\", address = \"${address}\" }))"
    done
fi
