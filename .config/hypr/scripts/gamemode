#!/usr/bin/env bash

HYPRGAMEMODE=$(hyprctl getoption animations:enabled | awk 'NR==1{print $2}')

if [ "$HYPRGAMEMODE" = "1" ] || [ "$HYPRGAMEMODE" = "true" ]; then
    hyprctl eval "hl.config({
        animations = { enabled = false },
        decoration = {
            shadow = { enabled = false },
            blur = { enabled = false },
            active_opacity = 1.0,
            inactive_opacity = 1.0,
            rounding = 0
        },
        general = {
            gaps_in = 0,
            gaps_out = 0,
            border_size = 1
        }
    })"

    killall waybar 2>/dev/null || true
    notify-send --icon=dialog-information "Gamemode activated" "Animations and blur disabled"
    exit 0
else
    hyprctl reload
    notify-send --icon=dialog-information "Gamemode deactivated" "Default settings restored"
    exit 0
fi



