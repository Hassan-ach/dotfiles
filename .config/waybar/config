{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 26,
    "spacing": 1,

    "modules-left": [
        "hyprland/workspaces#roman",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "swaync",
        "battery",
        "pulseaudio",
        "backlight",
        "network",
       // "custom/gpu_usage",
        "cpu",
        "memory",
        "custom/bluetooth",
        "temperature"
       // "tray"
    ],

    "hyprland/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{name} {icon}",
         "format-icons": {
         //    "1": "",
         //    "2": "",
         //    "3": "",
         //    "4": "",
         //    "5": "",
             "urgent": "",
             "active": "",
             "default": ""
         },
        "on-click": "activate"
    },

"hyprland/workspaces#roman": {
	"active-only": false,
	"all-outputs": true,
	"format": "{icon}",
	"show-special": false,
	"on-click": "activate",
	"on-scroll-up": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e+1\" }))'",
	"on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({ workspace = \"e-1\" }))'",
//    "persistent-workspaces": {
   //   "*": 5
//	},
	"format-icons": {
		"1": "I",
		"2": "II",
		"3": "III",
		"4": "IV",
		"5": "V",
		"6": "VI",
		"7": "VII",
		"8": "VIII",
		"9": "IX",
		"10": "X",
        "urgent": "",
        "active": "",
        "default": ""
	},
},
    "sway/window": {
        "max-length": 40,
        "tooltip": false,
        "separator": false
    },

"clock": {
	"interval": 1,
    "format": "  {:%I:%M %p}", // AM PM format
   // "format": "  {:%H:%M:%S}", // 24H
	"format-alt": "  {:%H:%M   %Y, %d %B, %A}",
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
		"mode": "month",
		"mode-mon-col": 3,
		"weeks-pos": "right",
		"on-scroll": 1,
		"format": {
			"months": "<span color='#ffead3'><b>{}</b></span>",
			"days": "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks": "<span color='#99ffdd'><b>W{:%V}</b></span>",
			"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
			"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
		}
	}
},

"battery": {
	//"interval": 5,
	"align": 0,
	"rotate": 0,
	//"bat": "BAT1",
	//"adapter": "ACAD",
	"full-at": 100,
	"design-capacity": false,
	"states": {
		"good": 95,
		"warning": 30,
		"critical": 15
	},
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-plugged": "󱘖 {capacity}%",
	"format-alt-click": "click",
	"format-full": "{icon} Full",
	"format-alt": "{icon} {time}",
	"format-icons": [
		"󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
	],
	"format-time": "{H}h {M}min",
	"tooltip": true,
	"tooltip-format": "{timeTo} {power}w",
},


    "pulseaudio": {
        "format": "<span foreground='#ebbcba'>  </span>{volume}%",
        "format-muted": "<span foreground='#6e6a86'>Muted</span>",
        "format-icons": {
            "default": [""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": true
    },

"backlight": {
	"interval": 2,
	"align": 0,
	"rotate": 0,
	//"format": "{icon} {percent}%",
	"format-icons": [
		" ",
		" ",
		" ",
		"󰃝 ",
		"󰃞 ",
		"󰃟 ",
		"󰃠 "
	],
	"format": "{icon} {percent}%",
	//"format-icons": ["","","","","","","","","","","","","","",""],
	"tooltip-format": "backlight {percent}%",
	"icon-size": 10,
	"on-click": "",
	"on-click-middle": "",
	"on-click-right": "",
	"on-update": "",
	"smooth-scrolling-threshold": 1,
},

    "network": {
        "interval": 1,
        "format-wifi": "<span foreground='#e0def4'>{essid}</span> ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-ethernet": "<span foreground='#e0def4'>🔗 {ifname}</span> ↓{bandwidthDownBits}",
        "format-disconnected": "<span foreground='#f6c177'>no wifi</span>",
        "tooltip": true,
        "max-length": 30
},

    "custom/gpu_usage": {
        "exec": "~/.config/polybar/gpu_usage.sh",
        "interval": 2,
        "format": "<span foreground='#ebbcba'>GPU </span>{}%",
        "return-type": "text"
    },

    "cpu": {
        "format": "<span foreground='#ebbcba'>CPU </span>{usage}%",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "<span foreground='#ebbcba'>RAM </span>{percentage}%",
        "interval": 2,
        "tooltip": true
    },

    "custom/bluetooth": {
        "exec": "bluetoothctl show | grep -q 'Powered: yes' && (name=$(bluetoothctl info | grep 'Name' | cut -d ' ' -f 2-); battery=$(upower -i $(upower -e | grep 'battery_BAT') | grep percentage | awk '{print $2}'); [ -z \"$name\" ] && echo \"󰂲 On\" || echo \" $name($battery)\") || echo \"󰂲 Off\"",
        "interval": 10,
        "format": "{}",
        "tooltip": true
    },

    "temperature": {
	"interval": 10,
	"tooltip": true,
	"hwmon-path": [
		"/sys/class/hwmon/hwmon1/temp1_input",
		"/sys/class/thermal/thermal_zone0/temp"
	],
	//"thermal-zone": 0,
	"critical-threshold": 82,
	"format-critical": "{temperatureC}°C {icon}",
	"format": "{temperatureC}°C {icon}",
	"format-icons": [
		"󰈸"
	]
    },

    "tray": {
        "spacing": 16
    },

"swaync": {
	"tooltip": true,
	"format": "{} {icon} ",
	"format-icons": {
		"notification": "<span foreground='red'><sup></sup></span>",
		"none": "",
		"dnd-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-none": "",
		"inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"inhibited-none": "",
		"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-inhibited-none": ""
	},
	"return-type": "json",
	"exec-if": "which swaync-client",
	"exec": "swaync-client -swb",
	"on-click": "sleep 0.1 && swaync-client -t -sw",
	"on-click-right": "swaync-client -d -sw",
	"escape": true,
},


}
